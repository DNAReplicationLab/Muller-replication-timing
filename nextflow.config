manifest {
    name            = 'Muller-replication-timing'
    author          = 'Nieduszynski lab (DNAReplicationLab)'
    description     = 'Replication timing profiles from DNA copy number: sort-seq, sync-seq and MFA-seq'
    homePage        = 'https://github.com/DNAReplicationLab/Muller-replication-timing'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '0.1.0'
}

params {
    help                = false

    // inputs
    samplesheet         = "${projectDir}/assets/samplesheet_muller2014.csv"
    comparisons         = "${projectDir}/assets/comparisons_muller2014.csv"
    fastq_dir           = null

    // reference
    fasta               = "${projectDir}/reference/sacCer3.fa"
    chrom_sizes         = "${projectDir}/reference/sacCer3.chrom.sizes"
    bowtie2_index       = null
    reference_dir       = "${projectDir}/reference"

    // analysis
    bin_size            = 1000
    min_read_length     = 25
    bin_lower_limit     = 0.25
    max_insert          = 750
    trep_validate_chrom = 'chrI'

    // runtime
    outdir              = 'results'
    r_bin               = null      // directory holding Rscript, when R lives in its own environment
    r_libs              = null      // R library holding Repliscope, if not on the default .libPaths()
    fastq_cache         = 'fastq'
    download_cache      = "${projectDir}/download_cache"  // raw ENA files, kept so an interrupted run resumes
    sra_max_size        = '50G'
    sort_memory         = '1G'
    max_cpus            = 12
    max_memory          = '32.GB'
}

process {
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 143, 247] ? 'retry' : 'finish' }
    maxRetries    = 2

    withLabel: process_low    { cpus = 2;                      memory = 4.GB  }
    withLabel: process_medium { cpus = 4;                      memory = 8.GB  }
    withLabel: process_high   { cpus = params.max_cpus as int; memory = 16.GB }

    // Repliscope is an R package; point --r_bin at an R installation that has it when
    // R is not on the PATH of the environment running the mapping tools.
    withName: 'REPLISCOPE_.*' {
        beforeScript = {
            def parts = []
            if (params.r_bin)  parts << "export PATH=${params.r_bin}:\$PATH"
            if (params.r_libs) parts << "export R_LIBS=${params.r_libs}:\${R_LIBS:-}"
            parts ? parts.join('\n') : 'true'
        }
    }
}

profiles {
    standard { process.executor = 'local' }
    conda {
        conda.enabled      = true
        conda.useMamba     = true
        process.conda      = "${projectDir}/env/environment.yml"
    }
    slurm {
        process.executor   = 'slurm'
        process.queue      = 'ei-medium'
        process.scratch    = true
    }
    test {
        params.samplesheet = "${projectDir}/assets/samplesheet_test.csv"
        params.comparisons = "${projectDir}/assets/comparisons_test.csv"
        params.bin_size    = 1000
        params.max_cpus    = 2
    }
}

report  { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html"   }
timeline{ enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
trace   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace.txt"     }
